{
  "semantics": [
    {
      "name": "taskDescription",
      "type": "text",
      "widget": "html",
      "label": "Инструкция для учащегося",
      "importance": "high",
      "default": "Нажмите на знак, после которого нужен пробел или знак. В появившееся поле ввода можно ввести знак с клавиатуры или добавить его кнопкой над текстом.",
      "tags": [
        "p",
        "br",
        "strong",
        "em",
        "u",
        "ul",
        "ol",
        "li",
        "a",
        "span",
        "sub",
        "sup"
      ]
    },
    {
      "name": "mode",
      "type": "select",
      "label": "Тип упражнения",
      "importance": "high",
      "default": "spacesAndPunctuation",
      "options": [
        {
          "value": "spacesAndPunctuation",
          "label": "Учащийся добавляет пробелы и знаки"
        },
        {
          "value": "spacesOnly",
          "label": "Учащийся добавляет только пробелы"
        },
        {
          "value": "punctuationOnly",
          "label": "Учащийся добавляет только знаки"
        }
      ]
    },
    {
      "name": "removableSymbols",
      "type": "text",
      "label": "Список удаляемых и восстанавливаемых символов",
      "importance": "high",
      "default": " ,.;:?!—",
      "description": "По умолчанию: пробел, запятая, точка, двоеточие, точка с запятой, вопросительный знак, восклицательный знак и тире. В соответствующих типах упражнения пробелы удаляются и требуются даже тогда, когда невидимый начальный пробел был пропущен при редактировании списка. Если в списке есть тире, дефис и тире при проверке считаются равнозначными. Отдельно стоящий дефис в тексте автора рассматривается как тире. Апостроф ' и его типографские варианты ’, ʼ, ′ при проверке считаются равнозначными."
    },
    {
      "name": "sentences",
      "type": "list",
      "label": "Предложения",
      "importance": "high",
      "min": 1,
      "entity": "предложение",
      "field": {
        "name": "sentenceItem",
        "type": "group",
        "label": "Предложение",
        "fields": [
          {
            "name": "instruction",
            "type": "text",
            "widget": "html",
            "label": "Инструкция для поля ответа",
            "importance": "medium",
            "default": "",
            "optional": true,
            "description": "Оставьте пустым, если над полем ответа этого предложения не нужно показывать отдельную инструкцию. Для каждого предложения можно задать свою инструкцию.",
            "tags": [
              "p",
              "br",
              "strong",
              "em",
              "u",
              "ul",
              "ol",
              "li",
              "a",
              "span",
              "sub",
              "sup"
            ]
          },
          {
            "name": "sentence",
            "type": "text",
            "label": "Языково корректное предложение",
            "importance": "high",
            "placeholder": "Введите предложение с пробелами и знаками.",
            "description": "Введите одно языково корректное предложение. Текст, скопированный с веб-страницы, в режиме учащегося очищается от HTML-сущностей."
          }
        ]
      },
      "default": [
        {
          "instruction": "",
          "sentence": "Привет, мир! Можешь добавить пробелы?"
        }
      ]
    },
    {
      "name": "behaviour",
      "type": "group",
      "label": "Настройки поведения",
      "importance": "low",
      "fields": [
        {
          "name": "enableRetry",
          "type": "boolean",
          "label": "Разрешить повторную попытку",
          "default": true
