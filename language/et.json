{
  "semantics": [
    {
      "name": "taskDescription",
      "type": "text",
      "widget": "html",
      "label": "Juhis õppijale",
      "importance": "high",
      "default": "Klõpsa tähele, mille järele on vaja tühikut või kirjavahemärki. Tekkinud sisestusalasse saad kirjavahemärgi kirjutada klaviatuurilt või lisada teksti kohal olevast kirjavahemärginupust.",
      "tags": [
        "p",
        "br",
        "strong",
        "em",
        "u",
        "ul",
        "ol",
        "li",
        "a",
        "span",
        "sub",
        "sup"
      ]
    },
    {
      "name": "mode",
      "type": "select",
      "label": "Harjutuse tüüp",
      "importance": "high",
      "default": "spacesAndPunctuation",
      "options": [
        {
          "value": "spacesAndPunctuation",
          "label": "Mängija lisab tühikud ja kirjavahemärgid"
        },
        {
          "value": "spacesOnly",
          "label": "Mängija lisab ainult tühikud"
        },
        {
          "value": "punctuationOnly",
          "label": "Mängija lisab ainult kirjavahemärgid"
        }
      ]
    },
    {
      "name": "removableSymbols",
      "type": "text",
      "label": "Eemaldatavate ja taastamist nõudvate sümbolite loend",
      "importance": "high",
      "default": " ,.;:?!—",
      "description": "Vaikimisi: tühik, koma, punkt, koolon, semikoolon, küsimärk, hüümärk ja mõttekriips. Tühikuid eemaldatakse ja nõutakse asjakohastes harjutusetüüpides ka siis, kui loendi alguses olev nähtamatu tühik jääb autori muutmisel sisestamata. Kui loendis on mõttekriips, võrdsustatakse vastamisel mõtte- ja sidekriips. Kui autor kasutab tekstis eraldi seisvat sidekriipsu, käsitletakse seda mõttekriipsuna. Apostroof ' ja selle tüpograafilised variandid ’, ʼ, ′ loetakse kontrollimisel samaväärseks."
    },
    {
      "name": "sentences",
      "type": "list",
      "label": "Laused",
      "importance": "high",
      "min": 1,
      "entity": "lause",
      "field": {
        "name": "sentenceItem",
        "type": "group",
        "label": "Lause",
        "fields": [
          {
            "name": "instruction",
            "type": "text",
            "widget": "html",
            "label": "Vastusekasti tööjuhis",
            "importance": "medium",
            "default": "",
            "optional": true,
            "description": "Jäta tühjaks, kui selle lause vastusekasti kohale ei pea ilmuma eraldi tööjuhist. Igal lausel võib olla erinev tööjuhis.",
            "tags": [
              "p",
              "br",
              "strong",
              "em",
              "u",
              "ul",
              "ol",
              "li",
              "a",
              "span",
              "sub",
              "sup"
            ]
          },
          {
            "name": "sentence",
            "type": "text",
            "label": "Keeleliselt korrektne lause",
            "importance": "high",
            "placeholder": "Sisesta lause koos tühikute ja kirjavahemärkidega.",
            "description": "Sisesta üks keeleliselt korrektne lause. Veebilehelt kopeeritud tekst puhastatakse mängija vaates HTML-üksustest."
          }
        ]
      },
      "default": [
        {
          "instruction": "",
          "sentence": "Tere, maailm! Kas oskad lisada tühikuid?"
        }
      ]
    },
    {
      "name": "behaviour",
